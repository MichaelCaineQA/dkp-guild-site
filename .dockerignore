.github
.zcode
.codebase-index
.idea
.vscode
docs
scripts

node_modules
**/node_modules

**/.next
**/dist
**/dist-seed
**/coverage
**/*.tsbuildinfo

.env
**/.env
**/.env.*
!**/.env.example

pnpm-store
*.log
