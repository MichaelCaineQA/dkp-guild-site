{
  "name": "dkp-guild-site",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,yml,yaml}\"",
    "db:generate": "pnpm --filter @dkp/api db:generate",
    "db:migrate": "pnpm --filter @dkp/api db:migrate",
    "db:seed": "pnpm --filter @dkp/api db:seed",
    "db:seed:test": "pnpm --filter @dkp/api db:seed:test"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3"
  }
}
