def backup_restore(c, release, backup_id):
    global ROOT, MANIFEST
    if not re.fullmatch(r'\d{8}T\d{12}Z', backup_id):
        fail('Некорректный идентификатор копии.')
    b = c.get('backup')
    if not b:
        fail('Сначала настройте ключ восстановления через dkp backup setup.')
    source = STATE / 'backups' / (backup_id + '.enc')
    signature = source.with_suffix('.hmac')
    if (not source.is_file() or not signature.is_file()) and b['mode'] == 'local':
        external = Path(b['target']) / (backup_id + '.enc')
        external_sig = external.with_suffix('.hmac')
        if external.is_file() and external_sig.is_file():
            source, signature = external, external_sig
    if (not source.is_file() or not signature.is_file()) and b['mode'] == 'ssh':
        source.parent.mkdir(mode=0o700, exist_ok=True)
        with tempfile.TemporaryDirectory(prefix='.download-', dir=STATE) as tmp:
            work = Path(tmp)
            for suffix in ('.enc', '.hmac'):
                run(['scp', '-q', '-o', 'BatchMode=yes', '-o', 'StrictHostKeyChecking=yes',
                     '-i', b['identity'], '-P', b['port'],
                     b['user'] + '@' + b['host'] + ':' + b['target'] + '/' + backup_id + suffix,
                     str(work / (backup_id + suffix))])
            remote = work / (backup_id + '.enc')
            remote_sig = work / (backup_id + '.hmac')
            if not hmac.compare_digest(mac_file(remote, key_bytes(b)), remote_sig.read_text().strip()):
                fail('Целостность удалённой копии не подтверждена.')
            os.chmod(remote, 0o600)
            os.chmod(remote_sig, 0o600)
            os.replace(remote, source)
            os.replace(remote_sig, signature)
    if not source.is_file() or not signature.is_file():
        fail('Копия не найдена в локальном каталоге резервных копий.')
    if not hmac.compare_digest(mac_file(source, key_bytes(b)), signature.read_text().strip()):
        fail('Проверка целостности копии не пройдена или указан неверный ключ.')
    with tempfile.TemporaryDirectory(prefix='.restore-', dir=STATE) as tmp:
        work = Path(tmp)
        run(['openssl', 'enc', '-d', '-aes-256-cbc', '-pbkdf2', '-iter', '250000',
             '-pass', 'file:' + b['key'], '-in', str(source), '-out', str(work / 'backup.tar')])
        expected = {'database.dump', 'screenshots.tar.gz', 'config.json', 'release-manifest.json'}
        try:
            with tarfile.open(work / 'backup.tar', 'r:') as archive:
                members = archive.getmembers()
                if {m.name for m in members} != expected or len(members) != len(expected):
                    fail('Некорректный состав резервной копии.')
                for member in members:
                    if not member.isfile():
                        fail('В копии обнаружен недопустимый тип файла.')
                    source_file = archive.extractfile(member)
                    if source_file is None:
                        fail('Не удалось прочитать файл копии.')
                    with (work / member.name).open('wb') as dest:
                        shutil.copyfileobj(source_file, dest)
            with tarfile.open(work / 'screenshots.tar.gz', 'r:gz') as archive:
                for member in archive:
                    name = Path(member.name)
                    if name.is_absolute() or '..' in name.parts or not (member.isfile() or member.isdir()):
                        fail('Архив скриншотов содержит небезопасные пути или ссылки.')
        except (tarfile.TarError, EOFError):
            fail('Резервная копия повреждена.')
        saved_release = json.loads((work / 'release-manifest.json').read_text(encoding='utf-8'))
        saved_config = json.loads((work / 'config.json').read_text(encoding='utf-8'))
        restore_release = release
        restore_root = ROOT
        if saved_release['version'] != release['version']:
            version = saved_release['version']
            if not re.fullmatch(r'v\d+\.\d+\.\d+(?:[-.][A-Za-z0-9.-]+)?', version):
                fail('Некорректная версия копии.')
            restore_root = STATE / 'releases' / version
            old_root, old_manifest = ROOT, MANIFEST
            try:
                ROOT, MANIFEST = restore_root, restore_root / 'release-manifest.json'
                restore_release = verify_release()
            finally:
                ROOT, MANIFEST = old_root, old_manifest
            if restore_release != saved_release:
                fail('Локальный релиз не соответствует манифесту резервной копии.')
        if not re.fullmatch(r'[0-9a-fA-F]{64}', saved_config['checkin_key']):
            fail('В копии отсутствует корректный ключ чек-ин кодов.')
        with (work / 'database.dump').open('rb') as f:
            compose(c, release, 'exec', '-T', 'db', 'pg_restore', '--list', stdin=f, stdout=subprocess.DEVNULL)
        print('Восстановление заменит БД и файлы установки:', c['domain'])
        if prompt('Для подтверждения введите домен сайта') != c['domain']:
            fail('Восстановление отменено.')
        backup_now(c, release)
        compose(c, release, 'stop', 'api')
        (STATE / 'migration-failed').write_text('restore\n')
        old_root, old_manifest = ROOT, MANIFEST
        ROOT, MANIFEST = restore_root, restore_root / 'release-manifest.json'
        try:
            for sql in (
                "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = 'dkp' AND pid <> pg_backend_pid()",
                'DROP DATABASE dkp', 'CREATE DATABASE dkp',
            ):
                compose(c, restore_release, 'exec', '-T', 'db', 'psql', '-U', 'dkp', '-d', 'postgres',
                        '-v', 'ON_ERROR_STOP=1', '-c', sql)
            with (work / 'database.dump').open('rb') as f:
                compose(c, restore_release, 'exec', '-T', 'db', 'pg_restore', '-U', 'dkp', '-d', 'dkp',
                        '--exit-on-error', '--no-owner', '--no-privileges', stdin=f)
            with (work / 'screenshots.tar.gz').open('rb') as f:
                compose(c, restore_release, 'run', '-T', '--rm', '--no-deps', '--entrypoint', 'sh', 'api', '-c',
                        'find /app/uploads/screenshots -mindepth 1 -maxdepth 1 -exec rm -rf -- {} + && '
                        'tar -xzf - -C /app/uploads/screenshots', stdin=f)
            c['checkin_key'] = saved_config['checkin_key']
            c['leader_pending'] = saved_config.get('leader_pending', True)
            atomic_json(CONFIG, c)
            compose(c, restore_release, 'up', '-d', '--wait', 'api', 'web', 'caddy')
            check_https(c)
            (STATE / 'installed-version').write_text(restore_release['version'] + '\n')
            if restore_root != old_root:
                link = STATE / '.current-new'
                link.unlink(missing_ok=True)
                link.symlink_to(restore_root, target_is_directory=True)
                os.replace(link, STATE / 'current')
            (STATE / 'migration-failed').unlink(missing_ok=True)
        except BaseException:
            try:
                compose(c, restore_release, 'stop', 'api')
            except Failure:
                pass
            print('Восстановление прервано. API остановлен; используйте созданную перед ним копию.', file=sys.stderr)
            raise
        finally:
            ROOT, MANIFEST = old_root, old_manifest
    print('Восстановление завершено.')

def update(c, current, requested):
    global ROOT, MANIFEST
    if (STATE / 'migration-failed').exists():
        fail('Сначала восстановите копию после прерванной миграции или восстановления.')
    repo = current.get('repository', '')
    if not re.fullmatch(r'[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+', repo):
        fail('В манифесте не указан корректный репозиторий релизов.')
    if requested and not re.fullmatch(r'v\d+\.\d+\.\d+(?:[-.][A-Za-z0-9.-]+)?', requested):
        fail('Версия должна иметь вид v1.2.3.')
    api = 'https://api.github.com/repos/' + repo + '/releases/' + (
        'tags/' + urllib.parse.quote(requested) if requested else 'latest')
    request = urllib.request.Request(api, headers={'Accept': 'application/vnd.github+json', 'User-Agent': 'dkp-installer'})
    with urllib.request.urlopen(request, timeout=30) as response:
        info = json.load(response)
    version = info['tag_name']
    if not re.fullmatch(r'v\d+\.\d+\.\d+(?:[-.][A-Za-z0-9.-]+)?', version):
        fail('Недопустимая версия релиза.')
    if version == current['version']:
        print('Эта версия уже установлена.')
        return
    filename = 'dkp-guild-site-' + version + '.tar.gz'
    assets = {asset['name']: asset['browser_download_url'] for asset in info['assets']}
    if filename not in assets or filename + '.sha256' not in assets:
        fail('В релизе отсутствуют архив или контрольная сумма.')
    releases = STATE / 'releases'
    releases.mkdir(mode=0o700, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix='.update-', dir=releases) as tmp:
        work = Path(tmp)
        def download(url, destination, limit):
            if not url.startswith('https://github.com/'):
                fail('Недоверенный адрес файла релиза.')
            req = urllib.request.Request(url, headers={'User-Agent': 'dkp-installer'})
            with urllib.request.urlopen(req, timeout=60) as src, destination.open('wb') as dst:
                total = 0
                while True:
                    chunk = src.read(1024 * 1024)
                    if not chunk:
                        break
                    total += len(chunk)
                    if total > limit:
                        fail('Файл релиза слишком велик.')
                    dst.write(chunk)
        download(assets[filename], work / filename, 100 * 1024 * 1024)
        download(assets[filename + '.sha256'], work / 'checksum', 4096)
        recorded = (work / 'checksum').read_text().split()
        actual = hashlib.sha256((work / filename).read_bytes()).hexdigest()
        if len(recorded) != 2 or recorded[0] != actual or recorded[1].lstrip('*') != filename:
            fail('Контрольная сумма скачанного релиза не совпадает.')
        files = {'dkp', 'compose.yml', 'Caddyfile', 'README.md', 'release-manifest.json', 'SHA256SUMS'}
        candidate = work / 'candidate'
        candidate.mkdir()
        with tarfile.open(work / filename, 'r:gz') as archive:
            found = set()
            for member in archive:
                parts = Path(member.name).parts
                if len(parts) == 1 and member.isdir():
                    continue
                if len(parts) != 2 or parts[0] != 'dkp-guild-site-' + version or parts[1] not in files or not member.isfile() or parts[1] in found:
                    fail('Архив релиза содержит неожиданные файлы или ссылки.')
                if member.size > 8 * 1024 * 1024:
                    fail('Файл в архиве релиза слишком велик.')
                found.add(parts[1])
                with (candidate / parts[1]).open('wb') as dst:
                    shutil.copyfileobj(archive.extractfile(member), dst)
            if found != files:
                fail('Архив релиза неполон.')
        (candidate / 'dkp').chmod(0o755)
        old_root = ROOT
        old_manifest = MANIFEST
        try:
            ROOT, MANIFEST = candidate, candidate / 'release-manifest.json'
            new_release = verify_release()
        finally:
            ROOT, MANIFEST = old_root, old_manifest
        if new_release['version'] != version or new_release.get('repository') != repo:
            fail('Манифест не соответствует выбранному релизу.')
        destination = releases / version
        if destination.exists():
            ROOT, MANIFEST = destination, destination / 'release-manifest.json'
            try:
                existing = verify_release()
            finally:
                ROOT, MANIFEST = old_root, old_manifest
            if existing != new_release:
                fail('Каталог этой версии не совпадает со скачанным релизом.')
        else:
            os.replace(candidate, destination)
        previous = releases / current['version']
        if not previous.exists():
            previous.mkdir(mode=0o700)
            for name in ('dkp', 'compose.yml', 'Caddyfile', 'README.md', 'release-manifest.json', 'SHA256SUMS'):
                shutil.copy2(old_root / name, previous / name)
        backup_now(c, current)
        ROOT, MANIFEST = destination, destination / 'release-manifest.json'
        try:
            compose(c, new_release, 'pull')
            compose(c, current, 'stop', 'api')
            (STATE / 'migration-failed').write_text(version + '\n')
            compose(c, new_release, 'run', '--rm', '--no-deps', 'api', './node_modules/.bin/prisma', 'migrate', 'deploy')
            compose(c, new_release, 'run', '--rm', '--no-deps', 'api', 'node', 'dist-seed/prisma/seed.js')
            compose(c, new_release, 'up', '-d', '--wait', 'api', 'web', 'caddy')
            check_https(c)
            (STATE / 'installed-version').write_text(version + '\n')
            link = STATE / '.current-new'
            link.unlink(missing_ok=True)
            link.symlink_to(destination, target_is_directory=True)
            os.replace(link, STATE / 'current')
            (STATE / 'migration-failed').unlink()
            print('Установлена версия', version)
        except BaseException:
            if (STATE / 'migration-failed').exists():
                try:
                    compose(c, new_release, 'stop', 'api')
                except Failure:
                    pass
            print('Обновление не завершено. Проверьте состояние и восстановите копию, созданную перед обновлением.', file=sys.stderr)
            raise
        finally:
            ROOT, MANIFEST = old_root, old_manifest

@contextlib.contextmanager
def lock():
    STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(STATE, 0o700)
    with (STATE / 'operation.lock').open('w') as f:
        try:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            fail('Другая операция DKP уже выполняется.')
        yield

def main():
    args = sys.argv[1:]
    if not args or args[0] in ('help', '--help', '-h'):
        print('dkp start | stop | restart | status | logs [сервис] | configure | leader | update [версия] | backup setup|now|list|restore <id>')
        return
    cmd = args[0]
    if cmd not in ('start', 'stop', 'restart', 'status', 'logs', 'configure', 'leader', 'update', 'backup'):
        fail('Неизвестная команда. Используйте dkp help.')
    release = verify_release()
    prerequisites()
    with lock():
        if cmd == 'start':
            persist_release(release)
        if cmd == 'start' and not CONFIG.exists():
            check_ports()
            c = configure()
            backup_setup(c)
            start(c, release)
            return
        c = load()
        if cmd == 'start':
            if not c.get('backup'):
                print('Завершите настройку резервных копий.')
                backup_setup(c)
            start(c, release)
        elif cmd == 'stop':
            compose(c, release, 'stop')
        elif cmd == 'restart':
            if (STATE / 'migration-failed').exists():
                fail('Обновление прервалось. Сначала восстановите копию до миграции.')
            compose(c, release, 'restart')
        elif cmd == 'status':
            print('Версия:', release['version'], '\nАдрес: https://' + c['domain'])
            if (STATE / 'migration-failed').exists():
                print('Внимание: прервана миграция или восстановление; требуется восстановить резервную копию.')
            backup_status = STATE / 'backup-status.json'
            if backup_status.exists():
                print('Последний бэкап:', backup_status.read_text(encoding='utf-8').strip())
            else:
                print('Резервные копии ещё не создавались.')
            compose(c, release, 'ps', '-a')
            try:
                addresses = sorted({entry[4][0] for entry in socket.getaddrinfo(c['domain'], 443, type=socket.SOCK_STREAM)})
                print('DNS:', ', '.join(addresses))
                with urllib.request.urlopen('https://' + c['domain'] + '/api/health', timeout=5) as response:
                    health = json.load(response)
                print('HTTPS/API: доступен; БД:', health.get('db', 'неизвестно'))
            except (OSError, ValueError):
                print('DNS, HTTPS или API недоступны; проверьте dkp logs caddy и dkp logs api.')
        elif cmd == 'logs':
            if len(args) > 2 or (len(args) == 2 and args[1] not in ('api', 'web', 'db', 'redis', 'caddy')):
                fail('Допустимые сервисы: api, web, db, redis, caddy.')
            compose(c, release, 'logs', '--tail=100', *(args[1:]))
        elif cmd == 'configure':
            configure(c)
            print('Настройки сохранены. Для применения выполните dkp start.')
        elif cmd == 'leader':
            leader_setup(c, release)
        elif cmd == 'backup' and args[1:] == ['setup']:
            backup_setup(c)
        elif cmd == 'backup' and args[1:] == ['now']:
            backup_now(c, release)
        elif cmd == 'backup' and args[1:] == ['list']:
            backup_list(c)
        elif cmd == 'backup' and len(args) == 3 and args[1] == 'restore':
            backup_restore(c, release, args[2])
        elif cmd == 'update' and len(args) <= 2:
            update(c, release, args[1] if len(args) == 2 else None)
        else:
            fail('Эта команда ещё не реализована; данные не изменены.')

if __name__ == '__main__':
    try:
        active = STATE / 'current' / 'dkp'
        if active.exists() and active.resolve() != Path(__file__).resolve():
            os.execv(sys.executable, [sys.executable, str(active), *sys.argv[1:]])
        main()
    except (Failure, OSError, ValueError, KeyError) as exc:
        print('Ошибка:', exc, file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        print('\nОперация прервана.', file=sys.stderr)
        sys.exit(130)
