# Скопируйте в .env.production на сервере; не публикуйте секреты.
WEB_HOST=example.com
API_HOST=api.example.com
POSTGRES_USER=dkp
POSTGRES_DB=dkp
POSTGRES_PASSWORD=change_me
# Пароль в URL должен быть URL-кодирован и совпадать с POSTGRES_PASSWORD.
DATABASE_URL=postgresql://dkp:change_me@db:5432/dkp?schema=public
SESSION_SECRET=replace_with_random_secret
CHECKIN_ENC_KEY=replace_with_64_hex_characters
ADMIN_LOGIN=admin
ADMIN_PASSWORD=replace_with_strong_password
# Можно настроить позже: без обоих значений доступен только вход администратора.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# По умолчанию https://<WEB_HOST>/api/auth/discord/callback.
# Для сохранения старого callback можно временно задать DISCORD_CALLBACK_URL.
# Для локальной проверки: CADDY_TLS=tls internal
CADDY_TLS=
