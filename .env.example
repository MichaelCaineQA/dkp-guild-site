# Копируй в apps/api/.env (для API). .env в .gitignore — секреты не коммитим.

# PostgreSQL (docker compose up -d db)
DATABASE_URL=postgresql://dkp:dkp@localhost:5432/dkp?schema=public

# Redis (docker compose up -d redis)
REDIS_URL=redis://localhost:6379

# Discord OAuth2 (https://discord.com/developers/applications)
# В настройках приложения Discord добавить Redirect URI как в DISCORD_CALLBACK_URL
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:3001/auth/discord/callback

# Ключ подписи сессионных cookie (сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=

# Резервный вход администратора (на случай проблем с Discord)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# Порт API (по умолчанию 3001)
PORT=3001

# Тестовый вход без Discord (e2e, ручная проверка ролей). ТОЛЬКО dev/staging!
# В production приложение с этим флагом не стартует.
AUTH_TEST_MODE=false

# --- apps/web/.env.local (фронт) ---
# NEXT_PUBLIC_API_URL=http://localhost:3001

# Ключ AES-256 (hex, 64 символа) для шифрования чек-ин кодов
CHECKIN_ENC_KEY=

# Запуск в Docker по http://localhost: false отключает Secure-флаг cookie (см. docker-compose.yml)
# COOKIE_SECURE=false

# --- Запуск всего сайта в контейнерах ---
# pnpm site:up        — сборка и запуск (web :3000, api :3001, БД, Redis)
# pnpm site:down      — остановить (данные БД в томе сохраняются)
# Секреты читаются из apps/api/.env; без файла сайт поднимется с dev-дефолтами
