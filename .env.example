# PostgreSQL (docker compose up -d db)
DATABASE_URL=postgresql://dkp:dkp@localhost:5432/dkp?schema=public

# Redis (docker compose up -d redis)
REDIS_URL=redis://localhost:6379

# Discord OAuth2 (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:3000/api/auth/discord/callback

# Ключ подписи сессионных cookie (сгенерировать: openssl rand -hex 32)
SESSION_SECRET=

# Порт API (по умолчанию 3001)
PORT=3001
