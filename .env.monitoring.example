# Uptime Kuma — мониторинг доступности (#305).
# Скопируйте в /opt/dkp-monitoring/.env.monitoring и ограничьте права (chmod 600).
# Формат — как у Docker: строка KEY=ЗНАЧЕНИЕ, без кавычек и комментариев в строке.
# Не публикуйте секреты.

# Пароль администратора панели. Не короче 8 символов, например:
#   openssl rand -base64 24
# При первом запуске kuma-setup.sh создаёт учётную запись с этим паролем,
# позже входит по нему. Сменив пароль в панели, обновите его и здесь.
KUMA_USERNAME=admin
KUMA_PASSWORD=replace_with_strong_password

# Откуда сценарий настройки обращается к Kuma. Внутри сервера — имя сервиса;
# снаружи, после публикации панели, можно wss://<поддомен> с компьютера с Node.js 22+.
KUMA_URL=ws://uptime-kuma:3001

# Адреса мониторов собираются из имён. Пустой KUMA_STAGING_HOST выключает
# мониторы стенда; KUMA_STAGING_NOTIFICATIONS=1 разрешает им слать оповещения
# (по умолчанию стенд виден только в панели).
KUMA_PRODUCTION_HOST=suneclipse.ru
KUMA_STAGING_HOST=stage.suneclipse.ru
KUMA_STAGING_NOTIFICATIONS=0

# Каналы оповещений: заполните нужные блоки, пустые не создаются.
# Discord — вебхук канала сервера гильдии (настройки канала → Интеграции → Вебхуки).
KUMA_DISCORD_WEBHOOK_URL=
# Почта: SMTP-сервер ящика и получатели через запятую.
# KUMA_SMTP_SECURE=true — TLS сразу (порт 465), иначе STARTTLS (587).
# KUMA_SMTP_FROM нужен, если сервер отпускает почту без логина.
KUMA_SMTP_HOST=
KUMA_SMTP_PORT=587
KUMA_SMTP_SECURE=false
KUMA_SMTP_USERNAME=
KUMA_SMTP_PASSWORD=
KUMA_SMTP_FROM=
KUMA_SMTP_TO=

# Оповещения ботом в личку Discord: Kuma шлёт вебхук на ретранслятор
# alert-relay, а тот пишет от имени бота сайта. Профиль alerts включает сервис.
# Без ALERT_RELAY_TOKEN канал не создаётся — тогда и профиль уберите.
COMPOSE_PROFILES=alerts
# Секрет между Kuma и ретранслятором, только буквы и цифры, например:
#   openssl rand -hex 24
ALERT_RELAY_TOKEN=
# Токен того же бота, что рассылает уведомления сайта (DISCORD_BOT_TOKEN
# в .env.production приложения). Бот должен видеть получателя на общем сервере.
ALERT_BOT_TOKEN=
# ID пользователя Discord (17–20 цифр); несколько — через запятую.
ALERT_DISCORD_USER_IDS=

# Часовой пояс панели и времени в оповещениях.
TZ=Europe/Moscow
